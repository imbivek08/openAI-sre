# ---------------------------------------------------------------------------
# OpenSRE AI — environment configuration
# Copy to .env and fill in. NEVER commit real values. All values below are
# safe placeholders.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Backend persistent store (PostgreSQL in docker-compose).
DATABASE_URL=postgresql+asyncpg://opensre:opensre@localhost:5432/opensre
# Demo API application database (same server, separate database).
DEMO_DATABASE_URL=postgresql+asyncpg://opensre:opensre@localhost:5432/opensre_demo

# --- Backend ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins for the dashboard.
CORS_ORIGINS=http://localhost:3000
# Admin key required for demo-control and evaluation endpoints (X-API-Key).
DEMO_ADMIN_KEY=change-me-admin-key
# Shared secret that protects the demo API's fault-injection endpoints.
DEMO_FAULT_SECRET=change-me-fault-secret

# --- Demo API (services/demo-api) --------------------------------------------
DEMO_API_PORT=8001

# --- Prometheus / runtime lab ------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
# Where the backend reads demo-api structured JSON logs from (shared volume).
DEMO_LOG_PATH=./var/log/demo-api/app.log

# --- AI model provider --------------------------------------------------------
# provider: "ollama" (local) or "hosted" (OpenAI-compatible endpoint).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
# API key for the hosted provider (not needed for Ollama).
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# Set to "false" when the selected local model does not support tool calling;
# the engine then uses a validated structured-JSON fallback.
LLM_TOOL_CALLING=true

# --- Investigation limits -----------------------------------------------------
INVESTIGATION_MAX_ITERATIONS=6
INVESTIGATION_MAX_TOOL_CALLS=20
INVESTIGATION_MAX_WALL_TIME_SECONDS=300
INVESTIGATION_MAX_CONTEXT_BYTES=200000
INVESTIGATION_MAX_TOOL_OUTPUT_BYTES=262144
INVESTIGATION_TOOL_TIMEOUT_SECONDS=20

# --- GitHub integration -------------------------------------------------------
# Fine-grained PAT or GitHub App token. Read-only permissions are preferred.
GITHUB_TOKEN=
# Comma-separated allowlist of repositories (owner/repo) the agent may query.
GITHUB_ALLOWED_REPOS=
# Secret used to verify X-Hub-Signature-256 webhook payloads.
GITHUB_WEBHOOK_SECRET=
# When "true", successful workflow runs are also investigated (default: false).
GITHUB_INVESTIGATE_SUCCESS=false

# --- Frontend (apps/dashboard) ------------------------------------------------
# Base URL of the FastAPI backend, used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
