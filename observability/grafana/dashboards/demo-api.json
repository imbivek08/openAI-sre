{
  "dashboard": {
    "title": "OpenSRE Demo API",
    "panels": [
      {
        "title": "HTTP Request Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum by (route) (rate(demo_http_requests_total[1m]))",
            "legendFormat": "{{route}}"
          }
        ]
      },
      {
        "title": "HTTP 5xx Ratio",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(demo_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(demo_http_requests_total[5m])), 0.000001)"
          }
        ]
      },
      {
        "title": "P95 Request Duration",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, route) (rate(demo_http_request_duration_seconds_bucket[5m])))",
            "legendFormat": "{{route}}"
          }
        ]
      },
      {
        "title": "DB Pool Checked Out",
        "type": "timeseries",
        "targets": [
          {
            "expr": "demo_db_pool_checkedout"
          },
          {
            "expr": "demo_db_pool_size"
          }
        ]
      },
      {
        "title": "Dependency Health",
        "type": "stat",
        "targets": [
          {
            "expr": "demo_dependency_up"
          }
        ]
      }
    ],
    "schemaVersion": 39,
    "version": 1
  }
}
